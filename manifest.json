{
  "schemaVersion": 1,
  "id": "io.github.joaodrp.controld",
  "name": "Control D",
  "version": "0.1.0",
  "author": "João Pereira",
  "license": "MIT",
  "description": "What Control D is doing on this machine, in the Omarchy bar, powered by cdctl.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Control D",
    "description": "Report what Control D is doing on this machine: its endpoint, profile, statistics and rules.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 120,
      "statsWindowHours": 24,
      "showStatistics": true,
      "showActivity": true,
      "activityRows": 8
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 120
      },
      {
        "key": "showStatistics",
        "type": "boolean",
        "label": "Show statistics",
        "defaultValue": true
      },
      {
        "key": "statsWindowHours",
        "type": "integer",
        "label": "Statistics window (hours)",
        "min": 1,
        "max": 720,
        "step": 1,
        "defaultValue": 24
      },
      {
        "key": "showActivity",
        "type": "boolean",
        "label": "Show recent activity",
        "defaultValue": true
      },
      {
        "key": "activityRows",
        "type": "integer",
        "label": "Activity rows",
        "min": 3,
        "max": 25,
        "step": 1,
        "defaultValue": 8
      }
    ]
  }
}
