{
  "schemaVersion": 1,
  "id": "io.github.joaodrp.controld",
  "name": "Control D",
  "version": "1.0.1",
  "author": "João Pereira",
  "license": "MIT",
  "description": "What Control D is doing on your machine, in the Omarchy bar, powered by cdctl.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Control D",
    "description": "What Control D is doing on your machine: your endpoint, its profile, statistics and rules.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 120,
      "statsWindowHours": 24,
      "showStatistics": true,
      "statsRows": 5,
      "showActivity": true,
      "activityRows": 10,
      "ruleRows": 15,
      "pauseCommand": "",
      "resumeCommand": "",
      "statusCommand": ""
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 120
      },
      {
        "key": "showStatistics",
        "type": "boolean",
        "label": "Show statistics",
        "defaultValue": true
      },
      {
        "key": "statsWindowHours",
        "type": "integer",
        "label": "Statistics window (hours)",
        "min": 1,
        "max": 720,
        "step": 1,
        "defaultValue": 24
      },
      {
        "key": "statsRows",
        "type": "integer",
        "label": "Rows per statistics list",
        "min": 3,
        "max": 20,
        "step": 1,
        "defaultValue": 5
      },
      {
        "key": "showActivity",
        "type": "boolean",
        "label": "Show recent activity",
        "defaultValue": true
      },
      {
        "key": "activityRows",
        "type": "integer",
        "label": "Activity rows",
        "min": 3,
        "max": 20,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "ruleRows",
        "type": "integer",
        "label": "Rules shown",
        "min": 5,
        "max": 100,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "statusCommand",
        "type": "string",
        "label": "Status command (exit 0 = Control D on)",
        "defaultValue": ""
      },
      {
        "key": "pauseCommand",
        "type": "string",
        "label": "Pause command (empty = no toggle)",
        "defaultValue": ""
      },
      {
        "key": "resumeCommand",
        "type": "string",
        "label": "Resume command",
        "defaultValue": ""
      }
    ]
  }
}
